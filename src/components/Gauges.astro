<div
  class="benchmark-art"
  data-illustration="gauges"
  role="img"
  aria-label="Animated memory and CPU usage gauges"
>
  <svg viewBox="0 32 536 256" aria-hidden="true">
    <defs>
      <linearGradient
        id="cpu-gradient"
        gradientTransform="rotate(-135 .5 .5)"
        x1="0"
        y1="1"
        x2="1"
        y2="0"
      >
        <stop stop-color="#ef1561" />
        <stop offset=".55" stop-color="#61ba92" />
      </linearGradient>
    </defs>
    {[
      {
        x: 144,
        label: 'MEMORY',
        mid: '2TiB',
        low: '0TiB',
        high: '4TiB',
        color: '#61ba92',
        angle: -22,
      },
      {
        x: 390,
        label: 'CPU',
        mid: '50,000%',
        low: '0%',
        high: '100,000%',
        color: 'url(#cpu-gradient)',
        angle: -148,
      },
    ].map((g, i) => (
      <g transform={`translate(${g.x} 160)`}>
        <circle r="120" fill="#33363d" />
        <circle r="110" fill="none" stroke="#777" stroke-width="20" />
        <circle
          class={`gauge-arc gauge-${i}`}
          r="110"
          fill="none"
          stroke={g.color}
          stroke-width="20"
          stroke-dasharray="480 660"
          transform="rotate(135)"
        />
        <circle r="55" fill="#f5f7f5" />
        <text
          text-anchor="middle"
          font-family="Inter,sans-serif"
          font-weight="800"
          font-size="18"
        >
          {g.label}
        </text>
        <text
          text-anchor="middle"
          y="15"
          font-family="Inter,sans-serif"
          font-size="8"
        >
          USAGE
        </text>
        <g
          class={`gauge-needle gauge-${i}`}
          transform={`rotate(${g.angle} 0 0)`}
        >
          <animateTransform
            attributeName="transform"
            type="rotate"
            values={`-25 0 0;${g.angle} 0 0;-25 0 0`}
            dur="8s"
            repeatCount="indefinite"
            begin="indefinite"
          />
          <path d="M-106 0h50" stroke="#ffc11e" stroke-width="2" />
        </g>
        <g
          fill="white"
          font-family="Inter,sans-serif"
          font-weight="700"
          font-size="10"
          text-anchor="middle"
        >
          <text y="-70">{g.mid}</text>
          <text x="-47" y="80">
            {g.low}
          </text>
          <text x="50" y="80">
            {g.high}
          </text>
        </g>
      </g>
    ))}
  </svg>
</div>
