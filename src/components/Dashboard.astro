---
import { highlightedCode } from '../utils/code';
---

<div class="dashboard-art" aria-hidden="true" data-illustration="dashboard">
  <div class="dashboard-frame">
    <div class="dashboard-top">
      <i></i>
      <i></i>
      <i></i>
    </div>
    <div class="dashboard-panes">
      <div class="dashboard-left">
        <span class="dashboard-tab">FILE.IPYNB　⊗</span>
        <div
          class="dashboard-code"
          data-loop-codes={JSON.stringify([
            '# Arrays implement the NumPy API\nimport dask.array as da\nx = da.random.random((1000, 1000),\n                     chunks=(100, 100))\nx.mean().compute()',
            '# DataFrames implement the pandas API\nimport dask.dataframe as dd\ndf = dd.read_parquet("s3://data/*.parquet")\ndf.value.mean().compute()',
          ])}
        >
          <code
            set:html={highlightedCode(
              '# Arrays implement the NumPy API\nimport dask.array as da\nx = da.random.random((1000, 1000),\n                     chunks=(100, 100))\nx.mean().compute()',
            )}
          />
        </div>
        <span class="dashboard-tab selected">PROGRESS STREAM　×</span>
        <svg
          class="progress-stream"
          viewBox="0 0 260 98"
          preserveAspectRatio="none"
        >
          <rect width="260" height="98" fill="#f6f6f6" />
          {Array.from({ length: 90 }, (_, i) => (
            <rect
              class="progress-task"
              x={8 + (i % 45) * 5}
              y={10 + Math.floor(i / 45) * 40}
              width="1"
              height="30"
              fill="#1f5aff"
              style={`--delay:${i * 90}ms`}
            />
          ))}
        </svg>
      </div>
      <div class="dashboard-right">
        <span class="dashboard-tab selected">TASK STREAM　×</span>
        <svg
          class="task-stream"
          viewBox="0 0 280 250"
          preserveAspectRatio="none"
        >
          <rect width="280" height="250" fill="#f6f6f6" />
          {Array.from({ length: 160 }, (_, i) => (
            <g class="stream-task" style={`--delay:${i * 65}ms`}>
              <rect
                x={8 + (i % 40) * 6}
                y={10 + Math.floor(i / 40) * 55}
                width="1"
                height="38"
                fill="#61ba92"
              />
              <rect
                x={10 + (i % 40) * 6}
                y={12 + Math.floor(i / 40) * 55}
                width="1"
                height="36"
                fill="#91d4b8"
              />
            </g>
          ))}
        </svg>
      </div>
    </div>
  </div>
</div>
