---
import { asset } from '../data/site';
import Terminal from './Terminal.astro';
const { item } = Astro.props;
---

<div class="workload-panel">
  <div class="workload-copy">
    <div class="workload-text">
      <h2 class="medium-title">{item.title}</h2>
      <p>{item.text}</p>
      <div class="workload-actions">
        <a class="button" href={item.href}>
          Documentation
        </a>
        {(item.secondary || item.video) && (
          <a class="text-link" href={item.secondary?.href || item.video}>
            {item.secondary?.label || item.videoLabel}
          </a>
        )}
      </div>
    </div>
    <div class="workload-logos">
      {item.logos.map((name) => (
        <img
          src={asset(name)}
          alt={name.replaceAll('_', ' ').replace(/\.svg$/, '')}
        />
      ))}
    </div>
  </div>
  <Terminal code={item.code} />
</div>
