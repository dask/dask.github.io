---
import Site from '../layouts/Site.astro';
import '../styles/home.css';
import '../styles/workloads.css';
import '../styles/deployment.css';
import '../styles/organizations.css';
import '../styles/closing.css';
import '../styles/cases.css';
import '../styles/testimonials.css';
import '../styles/illustrations.css';
import '../styles/performance.css';
import Terminal from '../components/Terminal.astro';
import Dashboard from '../components/Dashboard.astro';
import Gauges from '../components/Gauges.astro';
import CostCounter from '../components/CostCounter.astro';
import WorkloadPanel from '../components/WorkloadPanel.astro';
import { asset, docs } from '../data/site';
import { workloads, deployments } from '../data/home';
import quotes from '../data/quotes.json';
import cases from '../data/cases.json';
---

<Site>
  <section class="home-intro dark-grid">
    <div class="home-hero">
      <div class="home-headline">
        <h1 class="boxed">Parallel Python</h1>
        <h2 class="boxed">Fast and Easy</h2>
        <p>Easy Parallel Python that does what you need</p>
        <a class="button" href={docs}>
          Get started
        </a>
      </div>
      <Dashboard />
    </div>
    <div class="workload-tabs" data-tabs>
      <h2 class="section-title">What you can do with Dask</h2>
      <div
        class="tablist"
        role="tablist"
        aria-label="What you can do with Dask"
      >
        {workloads.map((w, i) => (
          <button
            id={`workload-tab-${i}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`workload-${i}`}
            tabindex={i === 0 ? 0 : -1}
          >
            {w.title}
          </button>
        ))}
      </div>
      {workloads.map((w, i) => (
        <div
          id={`workload-${i}`}
          role="tabpanel"
          aria-labelledby={`workload-tab-${i}`}
          hidden={i !== 0}
        >
          <WorkloadPanel item={w} />
        </div>
      ))}
    </div>
  </section>
  <section class="performance light-grid">
    <h2 class="section-title">Performance at Scale</h2>
    <div class="performance-row">
      <div class="performance-copy">
        <h3>Fast on Machines</h3>
        <p>
          Dask is lightweight, and runs your raw code on your machines without
          getting in the way. &nbsp;No virtualization or compilers.
        </p>
        <p>
          As the Python stack matures your code matures. Today{' '}
          <a
            class="text-link"
            href="https://docs.coiled.io/blog/spark-vs-dask.html?utm_source=dask.org&utm_medium=homepage"
          >
            Dask is 50% faster than Spark
          </a>{' '}
          on standard benchmarks.
        </p>
      </div>
      <div class="gauge-sheet">
        <Gauges />
      </div>
    </div>
    <div class="performance-row humans">
      <div class="human-code">
        <Terminal
          light
          code={
            'import pandas as pd\n\ndf = pd.read_parquet("s3://mybucket/myfile.parquet/")\n\ndf = df[df.value >= 0]\ndf.groupby("account")["value"].sum()'
          }
          loopCodes={[
            'import pandas as pd\n\ndf = pd.read_parquet("s3://mybucket/myfile.parquet/")\n\ndf = df[df.value >= 0]\ndf.groupby("account")["value"].sum()',
            'import dask.dataframe as dd\n\ndf = dd.read_parquet("s3://mybucket/myfile.*.parquet/")\n\ndf = df[df.value >= 0]\ndf.groupby("account")["value"].sum().compute()',
          ]}
        />
      </div>
      <div class="performance-copy">
        <h3>Made for Humans</h3>
        <p>
          <strong>Computers are cheap. Humans are expensive.</strong>
        </p>
        <p>Fortunately, humans already know how to use Dask.</p>
        <p>It’s just Python. It’s just pandas. It’s just NumPy.</p>
        <p>
          Dask’s dashboard guides you towards efficiency, quickly teaching you
          to become a distributed computing expert.
        </p>
      </div>
    </div>
    <div class="cheap">
      <h3>Cheap and Efficient</h3>
      <p>
        <strong>Fast humans + Fast machines = Cheap Computing</strong>
      </p>
      <CostCounter />
      <p>
        Dask users often process cloud data at{' '}
        <a
          class="text-link"
          href="https://docs.coiled.io/blog/ten-cents.html?utm_source=dask.org&utm_medium=homepage"
        >
          $0.10 per TiB
        </a>
      </p>
    </div>
  </section>
  <section class="deployment dark-grid">
    <h2 class="boxed">Where you can run Dask</h2>
    <div class="deployment-tabs" data-tabs>
      <div class="tablist" role="tablist" aria-label="Where to run Dask">
        {deployments.map((d, i) => (
          <button
            id={`deploy-tab-${i}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`deploy-${i}`}
            tabindex={i === 0 ? 0 : -1}
          >
            <span>{d.title}</span>
            {i === 0 && (
              <span class="deployment-switch" aria-hidden="true">
                <i />
              </span>
            )}
          </button>
        ))}
      </div>
      {deployments.map((d, i) => (
        <div
          id={`deploy-${i}`}
          role="tabpanel"
          aria-labelledby={`deploy-tab-${i}`}
          hidden={i !== 0}
        >
          <WorkloadPanel item={d} />
        </div>
      ))}
    </div>
  </section>
  <section class="testimonials">
    <div class="quote-intro">
      <h2>What users say about Dask</h2>
      <p>People use Dask and like it! You won’t be alone!</p>
      <ul class="quote-benefits" aria-label="Why people use Dask">
        <li>It’s easy</li>
        <li>It’s massive</li>
        <li>It solved my problem</li>
      </ul>
    </div>
    <div class="quote-columns">
      {[quotes.slice(0, 4), quotes.slice(4)].map((col) => (
        <div>
          {col.map((q) => (
            <figure class="quote">
              {q.logo && <img class="quote-logo" src={asset(q.logo)} alt="" />}
              <blockquote>{q.text}</blockquote>
              <figcaption>
                {q.portrait && <img src={asset(q.portrait)} alt="" />}
                {q.author}
              </figcaption>
            </figure>
          ))}
        </div>
      ))}
    </div>
  </section>
  <section class="org-band light-grid">
    <h2 class="medium-title">Organizations That Use Dask</h2>
    <div class="home-org-grid">
      {[
        'arm-logo.svg',
        'capital-one.png',
        'deshaw-co.png',
        'grubhub.png',
        'microsoft.png',
        'nasa.png',
        'nvidia.png',
        'shell.png',
        'two-sigma-logo.svg',
        'us-air-force.png',
        'defense-department.webp',
        'walmart.png',
      ].map((name) => (
        <div class="home-org-logo">
          <div class="home-org-media">
            <img
              src={asset(name)}
              alt={name.replace(/\.(svg|png|webp)$/, '').replaceAll('-', ' ')}
            />
          </div>
        </div>
      ))}
    </div>
  </section>
  <section class="use-cases light-grid large-grid">
    <h2 class="boxed">Use Cases</h2>
    <p>Anything you can do with Python, you can scale with Dask</p>
    <div class="cases-grid">
      {cases.map((c) => (
        <a class="case" href={c.href}>
          <div class="case-art">
            <img src={asset(c.image)} alt="" />
          </div>
          <div class="case-divider" aria-hidden="true"></div>
          <div class="case-info">
            <h3>{c.title}</h3>
            <small>Tools</small>
            <div class="tags">
              {c.tools.map((t) => (
                <span>{t}</span>
              ))}
            </div>
            <small>Data</small>
            <p>{c.data}</p>
          </div>
        </a>
      ))}
      <div class="more-cases">
        <h3>Want more examples?</h3>
        <p>Visit the Dask Blog or Dask Youtube Channel</p>
        <div>
          <a
            class="button"
            href="https://www.youtube.com/playlist?list=PLJ0vO2F_f6OD0cwscL_yeG1aC3ESBquAT"
          >
            Dask Demo Day
          </a>
          <a class="text-link" href="https://www.youtube.com/c/dask-dev">
            Dask YouTube Channel
          </a>
        </div>
      </div>
    </div>
  </section>
  <section class="home-install light-grid">
    <div>
      <h2>Super easy to get started</h2>
      <p>
        You can run Dask right now on your computer. It’s simple and
        lightweight.
      </p>
      <div class="closing-actions">
        <a class="button" href="https://docs.dask.org/en/latest/install.html">
          Install Now
        </a>
      </div>
    </div>
    <Terminal
      light
      code="$ conda install dask"
      install
      loopCodes={['$ conda install dask', '$ pip install "dask[complete]"']}
    />
  </section>
  <section class="laptop-note">
    <img
      class="closing-art"
      src={asset('illustration-home-stay-connected.svg')}
      alt=""
    />
    <div class="laptop-copy">
      <p>
        Most people use Dask just on their laptops to scale out to 100 GiB
        datasets. Dask works great on a single machine.
      </p>
      <a class="text-link" href={docs}>
        Proceed to documentation
      </a>
    </div>
  </section>
</Site>
