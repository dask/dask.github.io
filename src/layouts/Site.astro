---
import '../styles/global.css';
import '../styles/chrome.css';
import '../styles/copy-papers.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Dialogs from '../components/Dialogs.astro';
const {
  analytics = true,
  title = 'Dask | Parallel Python',
  description = 'Dask is a flexible library for parallel computing in Python.',
} = Astro.props;
const tagManagerId = 'GTM-P4GQM59';
const enableTagManager =
  analytics &&
  import.meta.env.PROD &&
  process.env.DASK_PAGES_ANALYTICS === '1' &&
  !process.env.READTHEDOCS_CANONICAL_URL &&
  Astro.site?.origin === 'https://dask.org' &&
  import.meta.env.BASE_URL === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    {enableTagManager && <script define:vars={{ tagManagerId }}>
      if (window.location.origin === 'https://dask.org') {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          'gtm.start': Date.now(),
          event: 'gtm.js',
        });
        const loader = document.createElement('script');
        loader.async = true;
        loader.src =
          'https://www.googletagmanager.com/gtm.js?id=' + tagManagerId;
        document.head.appendChild(loader);
      }
    </script>}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link
      rel="icon"
      type="image/svg+xml"
      href="/assets/Dask-Logo-Icon-Primary.svg"
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  </head>
  <body>
    {enableTagManager && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${tagManagerId}`}
          title="Google Tag Manager"
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        />
      </noscript>
    )}
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Dialogs />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
